{
    "defaultSeverity": "error",
    "extends": [
        "tslint-etc",
        "tslint:recommended",
        "tslint-react"
    ],
    "jsRules": {},
    "rules": {
        "no-implicit-dependencies": [true, "dev"],
        "object-literal-sort-keys": false,
        "interface-name": false,
        "jsx-no-multiline-js": false,
        "arrow-parens": true,
        "max-line-length": [true, {"limit": 120, "ignore-pattern": "^import [^;]+ from |^} from |^export |class [^,]+ implements |await queryRunner\\.query|`,$"}],
        "ordered-imports": [true],
        "quotemark": [true, "double"],
        "no-unused-declaration": true
    },
    "rulesDirectory": [],
    "linterOptions": {
        "exclude": [
            "config/**/*.js",
            "node_modules/**/*.ts",
            "src/serviceWorker.ts"
        ]
    }
}
