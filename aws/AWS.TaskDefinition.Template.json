{
  "taskRoleArn": "arn:aws:iam::817083319299:role/shifamed-task-role",
  "containerDefinitions": [
    {
      "name": "<container_name>",
      "image": "<container_image>",
      "memoryReservation": 64,
      "environment": [
        {
          "name": "REACT_APP_AWS_COGNITO_CLIENT_ID",
          "value": ""
        },
        {
          "name": "REACT_APP_FRONTEND_URL",
          "value": ""
        },
        {
          "name": "REACT_APP_SIGNUP_DOMAIN_URL",
          "value": ""
        },
        {
          "name": "REACT_APP_API_ENDPOINT",
          "value": ""
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "doc-fe",
          "awslogs-group": "/ecs-develop"
        }
      },
      "portMappings": [
        {
          "protocol": "tcp",
          "containerPort": 5000,
          "hostPort": 0
        }
      ],
      "dockerLabels": {},
      "essential": true,
      "volumesFrom": []
    }
  ]
}